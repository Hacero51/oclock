{
  "name": "oclock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run start:python\" --names \"NEXT,PYTHON\" --prefix-colors \"bgBlue.bold,bgYellow.bold\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "start:python": "python python_service/main.py",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:sync-masters": "npx tsx scripts/sync_all_data.ts",
    "db:sync-attendance": "npx tsx scripts/sync_attendance_data.ts",
    "db:clean-logs": "powershell -Command \"'--- LOG CLEANED ---' | Out-File sync_debug_log.txt -Encoding utf8\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.7",
    "@trpc/client": "^11.7.1",
    "@trpc/react-query": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.548.0",
    "next": "^16.0.9",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.7",
    "prisma": "^6.19.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zklib-js": "^1.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "init": "^0.1.2",
    "npx": "^10.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5"
  }
}
